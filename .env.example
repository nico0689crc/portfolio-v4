# ===========================================================================
# Copiá este archivo a `.env` y completá los valores.
#   cp .env.example .env
# `.env` está en .gitignore y nunca se commitea. Este archivo sí.
# ===========================================================================


# ---------------------------------------------------------------------------
# Supabase — contenido del sitio y backoffice
#
# Dashboard → Project Settings → API. En proyectos nuevos las dos primeras
# aparecen como "Publishable key" y la tercera como "Secret key"; son las
# mismas claves con otro nombre.
# ---------------------------------------------------------------------------

# URL del proyecto. Pública: viaja al browser.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clave anónima. Pública por diseño: se incluye en el bundle del cliente y
# cualquiera puede leerla. Lo que impide que eso sea un problema es RLS — con
# esta clave sólo se ve lo que las policies dejan ver al rol `anon`, o sea el
# contenido publicado. Es la que usa todo el sitio público.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave de service role. SALTEA RLS POR COMPLETO: lee y escribe todo, incluidos
# borradores y mensajes de contacto.
#   - Nunca la prefijes con NEXT_PUBLIC_.
#   - Nunca la importes desde un Client Component.
#   - La usan los scripts de seed y migración que corren en tu máquina, y una
#     sola ruta dentro de la app: src/app/api/cron/linkedin-share/route.ts
#     (corre sin sesión de usuario, así que no hay otra forma de escribir).
#     No la importes desde ningún otro archivo.
# Si se filtra, rotala desde el dashboard.
SUPABASE_SERVICE_ROLE_KEY=


# ---------------------------------------------------------------------------
# Supabase CLI — migraciones y generación de tipos
#
# Sólo hace falta para trabajar contra el proyecto hosteado:
#   supabase link --project-ref $SUPABASE_PROJECT_REF
#   supabase db push
#   supabase gen types typescript --linked > src/types/database.ts
#
# Para desarrollo local con `supabase start` no se necesita ninguna de las dos.
# ---------------------------------------------------------------------------

# Token de acceso personal, desde https://supabase.com/dashboard/account/tokens
# El CLI lo lee de esta variable, así que evita tener que correr `supabase login`
# de forma interactiva. Tiene que pertenecer a la cuenta DUEÑA del proyecto:
# si estás logueado con otra, `supabase link` falla con un error de privilegios
# aunque las claves del proyecto sean correctas.
SUPABASE_ACCESS_TOKEN=

# El identificador del proyecto: la parte de la URL antes de .supabase.co
SUPABASE_PROJECT_REF=

# Contraseña de la base, la que definiste al crear el proyecto.
# Dashboard → Project Settings → Database si no la recordás.
SUPABASE_DB_PASSWORD=

# Alternativa al par ACCESS_TOKEN + PROJECT_REF: la cadena de conexión completa,
# para `supabase db push --db-url "$SUPABASE_DB_URL"`.
# Usá la del POOLER (Connection pooling en el dashboard), no la conexión directa:
# db.<ref>.supabase.co resuelve sólo a IPv6 y falla en redes sin IPv6.
#   postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=


# ---------------------------------------------------------------------------
# SMTP — formulario de contacto (src/actions/sendEmail.ts)
# ---------------------------------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Casilla que recibe los mensajes del formulario.
CONTACT_EMAIL=


# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# ID de medición de GA4 (G-XXXXXXXXXX). Si se deja vacío, el tracking no se
# inicializa y el sitio funciona igual.
NEXT_PUBLIC_GA_ID=

# Invalida el cache de contenido tras un seed o un cambio hecho fuera de la app.
REVALIDATE_SECRET=


# ---------------------------------------------------------------------------
# Cron jobs (vercel.json)
# ---------------------------------------------------------------------------

# Secreto que Vercel manda solo como header `Authorization: Bearer $CRON_SECRET`
# en cada invocación de un cron job. Con esto, cualquier ruta bajo
# src/app/api/cron/ puede verificar que quien la llama es Vercel y no un
# tercero. Generalo con algo como `openssl rand -hex 32`.
CRON_SECRET=


# ---------------------------------------------------------------------------
# LinkedIn — publicación directa (src/lib/social/linkedin.ts)
# ---------------------------------------------------------------------------
# El camino principal. El calendario se arma en /admin/linkedin y el cron diario
# publica lo que venció, con su imagen o su PDF y el link como primer comentario.
#
# Se configura creando una app en https://www.linkedin.com/developers/apps y
# agregándole el producto «Share on LinkedIn», que es self-serve y concede
# `w_member_social` sin pasar por aprobación de partner. La cuenta se conecta
# desde el propio panel; el token vive en la tabla `social_accounts`, no acá.
#
# Ojo con el token: dura 60 días y LinkedIn no da refresh token programático a
# apps self-serve, así que hay que reconectar desde el panel cada dos meses. El
# panel avisa diez días antes.

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Tiene que coincidir carácter por carácter con la registrada en el portal.
# Vacía usa {origin}/api/admin/linkedin/callback, que es lo correcto en Vercel.
LINKEDIN_REDIRECT_URI=

# Scopes pedidos al autorizar. El default es `openid profile w_member_social`.
# `w_member_social_feed` —el permiso para dejar el link como primer comentario—
# es un scope aparte que «Share on LinkedIn» no incluye: agregalo acá sólo si el
# portal llega a concederlo, porque pedir un scope que la app no tiene hace
# fallar la autorización entera.
LINKEDIN_SCOPES=

# Versión de la API, en formato YYYYMM. Cada versión se da de baja al año, así
# que esto existe para poder subirla sin deploy. Default 202608.
LINKEDIN_API_VERSION=


# ---------------------------------------------------------------------------
# Buffer — camino alternativo (src/lib/buffer.ts)
# ---------------------------------------------------------------------------
# Sólo se usa en los envíos con `provider = 'buffer'`. Existe como salida por si
# renovar el token de LinkedIn cada 60 días se vuelve un problema: Buffer no
# vence, pero cobra el primer comentario y los documentos.
# Buffer conecta con LinkedIn; acá sólo se guarda la key personal de la API de
# Buffer, no ninguna credencial de LinkedIn. El calendario se arma a mano en
# /admin/linkedin y el cron diario (src/app/api/cron/linkedin-share) sólo lo
# ejecuta: entrega a Buffer los envíos que están por vencer, con su fecha exacta
# como `dueAt`. La cola de Buffer no se usa — el turno lo decide la agenda.

# Personal API key, desde Settings → API en tu cuenta de Buffer (acceso beta,
# hay que pedirlo primero). Sin esto el cron no falla: responde 501 y no
# comparte nada.
BUFFER_API_KEY=

# Id del canal de LinkedIn conectado en Buffer.
BUFFER_LINKEDIN_CHANNEL_ID=

# Tope de envíos que entrega cada corrida del cron. Es una red de seguridad, no
# la cadencia: la cadencia la define la agenda del panel. Default 1.
LINKEDIN_SHARE_LIMIT=1


# ---------------------------------------------------------------------------
# Medición de SEO (panel /admin/metricas)
# ---------------------------------------------------------------------------
# Cuenta de servicio de Google con permiso de LECTURA en la propiedad de GA4 y
# en la de Search Console. Solo lee: si se dejan vacías, el panel abre igual y
# explica qué falta.

# El JSON entero de la clave, en una sola línea. En local acepta también la
# ruta a un archivo fuera del repo.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ID numérico de la propiedad de GA4. No es el G-XXXXXXXXXX.
GA4_PROPERTY_ID=

# Propiedad de Search Console, tal como figura ahí:
# sc-domain:ejemplo.com  o  https://www.ejemplo.com/
SEARCH_CONSOLE_SITE_URL=
